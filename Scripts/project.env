PROJECT_NAME=XcodePilot

APP_DISPLAY_NAME="Xcode Pilot"

TARGET_NAME=XcodePilot

TARGET_BUNDLE_ID=dev.ivon.XcodePilot

# Apple Developer team the targets are signed by, referenced as ${DEVELOPMENT_TEAM_ID} from the
# xcodegen specs. Not a secret: it ships inside every signed build. A stable signature also keeps
# the Accessibility permission (used to open Xcode's Organizer / Devices windows) across rebuilds.
DEVELOPMENT_TEAM_ID=QT27G5NN83
